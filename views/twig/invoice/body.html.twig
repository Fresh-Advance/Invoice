{% set order = invoice.getOrder() %}
{% set shop = invoice.getShop() %}
{% set configuration = invoice.getInvoiceConfiguration() %}
{% set totals_colspan = 5 %}

{% block fa_invoice_invoice_body %}
    <style>
        {% block fa_invoice_invoice_body_style %}

            {% block fa_invoice_invoice_body_style_page %}
                @page {
                    size: auto;
                    header: myHeader;
                    footer: myFooter;
                    {% if layoutSettings.getMarginTop() %} margin-top: {{ layoutSettings.getMarginTop() }};{% endif %}
                    {% if layoutSettings.getMarginBottom() %} margin-bottom: {{ layoutSettings.getMarginBottom() }};{% endif %}
                    {% if layoutSettings.getMarginLeft() %} margin-left: {{ layoutSettings.getMarginLeft() }};{% endif %}
                    {% if layoutSettings.getMarginRight() %} margin-right: {{ layoutSettings.getMarginRight() }};{% endif %}
                }
            {% endblock %}

            {% block fa_invoice_invoice_body_style_other %}
                #buyer, #seller {
                    width: 50%;
                    float: left;
                }

                .contactHead {
                    font-weight: bold;
                    margin-bottom: 10px;
                }

                #number, #date, #invoiceSign {
                    text-align: right;
                    font-weight: bold;
                    margin: 25px 0;
                }

                #facture {
                    text-align: center;
                    font-weight: bold;
                    font-size: 16px;
                    margin: 25px 0;
                }

                #contentTable {
                    width: 100%;
                    border-width: 0;
                    margin: 15px 0;
                }

                td {
                    font-size: 12px;
                    padding: 5px 0;
                    border-top: solid 1px black;
                }

                .contentHeader td {
                    font-weight: bold;
                }

                td.itemCount,
                td.itemPrice,
                td.itemTotalPrice {
                    text-align: right;
                }

                .itemSize,
                .itemCode,
                .itemCount {
                    width: 10%;
                }

                .itemPrice,
                .itemTotalPrice {
                    width: 15%;
                }

                #delivery td, #total td, #discount td, #vouchers td, #payment td, .totalvats td {
                    text-align: right;
                }
            {% endblock %}

        {% endblock %}
    </style>

    {% block fa_invoice_invoice_body_headers %}
        <htmlpageheader name="myHeader" style="display:none">
            {% if layoutSettings.getDocumentHeader() %}{{ layoutSettings.getDocumentHeader()|raw }}{% endif %}
        </htmlpageheader>
    {% endblock %}

    {% block fa_invoice_invoice_body_footers %}
        <htmlpagefooter name="myFooter" style="display:none">
            {% if layoutSettings.getDocumentFooter() %}{{ layoutSettings.getDocumentFooter()|raw }}{% endif %}
        </htmlpagefooter>
    {% endblock %}

    {% block fa_invoice_invoice_body_seller %}
        <div id="seller">
            <div class="contactHead">{{ translate({ ident: "FA_INVOICE_SELLER" }) }}</div>
            <div>
                <strong>{{ shop.getFieldData('OXCOMPANY') }}</strong><br/>
                {{ shop.getFieldData('OXSTREET') }}<br/>
                {{ shop.getFieldData('OXZIP') }} {{ shop.getFieldData('OXCITY') }}, {{ shop.getFieldData('OXCOUNTRY') }}
                <br/>
                {{ translate({ ident: "FA_INVOICE_TAXID" }) }}: {{ shop.getFieldData('OXTAXNUMBER') }}<br/>
                {{ shop.getFieldData('OXINFOEMAIL') }}
            </div>
        </div>
    {% endblock %}

    {% block fa_invoice_invoice_body_buyer %}
        <div id="buyer">
            <div class="contactHead">{{ translate({ ident: "FA_INVOICE_BUYER" }) }}</div>
            <div>
                {% if order.getFieldData('oxbillcompany') %}
                    <strong>{{ order.getFieldData('oxbillcompany') }}</strong><br/>
                {% endif %}

                {% if order.getFieldData('oxbillustid') %}
                    {{ order.getFieldData('oxbillustid') }}<br/>
                {% endif %}

                {{ order.getFieldData('OXBILLFNAME') }} {{ order.getFieldData('OXBILLLNAME') }}<br/>
                {{ order.getFieldData('OXBILLZIP') }} {{ order.getFieldData('OXBILLCITY') }}, {{ order.getBillCountry() }}
                <br/>
                {{ order.getFieldData('OXBILLEMAIL') }}
            </div>
        </div>
    {% endblock %}

    <div></div>

    {% block fa_invoice_invoice_body_order_number %}
        <div id="number">{{ translate({ ident: "FA_INVOICE_ORDERNR" }) }}: {{ order.getFieldData('oxordernr') }}</div>
    {% endblock %}

    {% block fa_invoice_invoice_body_invoice_date %}
        <div id="date">{{ translate({ ident: "FA_INVOICE_DATE" }) }}: {{ configuration.getFormattedDate() }}</div>
    {% endblock %}

    {% block fa_invoice_invoice_body_invoice_number %}
        <div id="facture">{{ translate({ ident: "FA_INVOICE_NUMBER" }) }} {{ configuration.getFormattedNumber(order.getFieldData('oxbillnr')) }}</div>
    {% endblock %}

    {% block fa_invoice_invoice_body_content_table %}
        <table id="contentTable">

            {% block fa_invoice_invoice_body_items_header %}
                <tr class="contentHeader">
                    <td class="itemTitle">{{ translate({ ident: "FA_INVOICE_ITEM_TITLE" }) }}</td>
                    <td class="itemCode">{{ translate({ ident: "FA_INVOICE_ITEM_CODE" }) }}</td>
                    <td class="itemSize">{{ translate({ ident: "FA_INVOICE_ITEM_TYPE" }) }}</td>
                    <td class="itemCount">{{ translate({ ident: "FA_INVOICE_ITEM_COUNT" }) }}</td>
                    <td class="itemPrice">{{ translate({ ident: "FA_INVOICE_ITEM_PRICE" }) }}</td>
                    <td class="itemTotalPrice">{{ translate({ ident: "FA_INVOICE_ITEM_PRICE_TOTAL" }) }}</td>
                </tr>
            {% endblock %}

            {% block fa_invoice_invoice_body_items %}
                {% for item in order.getOrderArticles() %}
                    <tr class="item">
                        <td class="itemTitle">{{ item.faGetTranslatedTitle(invoice.getLanguageId()) }}</td>
                        <td class="itemCode">{{ item.getFieldData('oxartnum') }}</td>
                        <td class="itemSize">{{ translate({ ident: "FA_INVOICE_PCS" }) }}</td>
                        <td class="itemCount">{{ item.getFieldData('oxamount') }}</td>
                        <td class="itemPrice">{{ item.getNetPriceFormated() }} {{ order.getFieldData('oxcurrency') }}</td>
                        <td class="itemTotalPrice">{{ item.getTotalNetPriceFormated() }} {{ order.getFieldData('oxcurrency') }}</td>
                    </tr>
                {% endfor %}
            {% endblock %}

            {% block fa_invoice_invoice_body_totals %}

                {% block fa_invoice_invoice_body_totals_discount %}
                    {% if order.getFieldData('oxdiscount') %}
                        <tr id="discount">
                            <td colspan="{{ totals_colspan }}">{{ translate({ ident: "FA_INVOICE_DISCOUNT" }) }}:</td>
                            <td>- {{ order.getFormattedDiscount() }} {{ order.getFieldData('oxcurrency') }}</td>
                        </tr>
                    {% endif %}
                {% endblock %}

                {% block fa_invoice_invoice_body_totals_vouchers %}
                    {% if order.getFieldData('oxvoucherdiscount') %}
                        <tr id="vouchers">
                            <td colspan="{{ totals_colspan }}">{{ translate({ ident: "FA_INVOICE_VOUCHERS" }) }}:</td>
                            <td>- {{ order.getFormattedTotalVouchers() }} {{ order.getFieldData('oxcurrency') }}</td>
                        </tr>
                    {% endif %}
                {% endblock %}

                {% block fa_invoice_invoice_body_totals_delivery %}
                    {% if order.getFieldData('oxdelcost') %}
                        <tr id="delivery">
                            <td colspan="{{ totals_colspan }}">{{ translate({ ident: "FA_INVOICE_DELIVERY" }) }}:</td>
                            <td>{{ order.getFormattedDeliveryCost() }} {{ order.getFieldData('oxcurrency') }}</td>
                        </tr>
                    {% endif %}
                {% endblock %}

                {% block fa_invoice_invoice_body_totals_payment %}
                    {% if order.getFieldData('oxpaycost') %}
                        <tr id="payment">
                            <td colspan="{{ totals_colspan }}">{{ translate({ ident: "FA_INVOICE_PAYMENT" }) }}:</td>
                            <td>{{ order.getFormattedPayCost() }} {{ order.getFieldData('oxcurrency') }}</td>
                        </tr>
                    {% endif %}
                {% endblock %}

                {% block fa_invoice_invoice_body_totals_vats %}
                    {% for vat, vatPrice in order.getProductVats() %}
                        <tr class="totalvats">
                            <td colspan="{{ totals_colspan }}">{{ translate({ ident: "FA_INVOICE_VATS" }) }} ({{ vat }}%):</td>
                            <td>{{ vatPrice }} {{ order.getFieldData('oxcurrency') }}</td>
                        </tr>
                    {% endfor %}
                {% endblock %}

                {% block fa_invoice_invoice_body_totals_total %}
                    <tr id="total">
                        <td colspan="{{ totals_colspan }}">{{ translate({ ident: "FA_INVOICE_TOTAL" }) }}:</td>
                        <td>{{ order.getFormattedTotalOrderSum() }} {{ order.getFieldData('oxcurrency') }}</td>
                    </tr>
                {% endblock %}

            {% endblock %}

        </table>
    {% endblock %}

    {% block fa_invoice_invoice_body_sum_in_words %}
        {{ translate({ ident: "FA_INVOICE_TOTAL_IN_WORDS"}) }}: {{ wording.currencyToWords(order.getFieldData('oxtotalordersum') * 100, order.getFieldData('oxcurrency')) }}
    {% endblock %}

    {% block fa_invoice_invoice_body_sign %}
        {% if configuration.getSigner() %}
            <div id="invoiceSign">{{ translate({ ident: "FA_INVOICE_SIGNED" }) }}: {{ configuration.getSigner() }}</div>
        {% endif %}
    {% endblock %}
{% endblock %}
